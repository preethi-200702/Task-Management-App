# Server Configuration
PORT=5000
NODE_ENV=development

# Client URL (CORS allowed origin for frontend)
CLIENT_URL=http://localhost:5173

# Database Connection (MongoDB Atlas or local MongoDB)
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/bloomtask?retryWrites=true&w=majority
# Example Local: mongodb://127.0.0.1:27017/bloomtask
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/bloomtask?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_random_string_here_bloomtask_2026
JWT_EXPIRES_IN=7d
